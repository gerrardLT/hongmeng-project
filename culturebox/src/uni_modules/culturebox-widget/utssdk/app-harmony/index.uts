/**
 * CultureBox 鸿蒙负一屏服务卡片 UTS 插件
 *
 * 本插件仅在鸿蒙端（APP-HARMONY）编译运行，提供服务卡片的数据获取、更新和点击跳转能力。
 * 由于 UTS 在鸿蒙端编译为 ArkTS，可直接调用鸿蒙原生 API。
 *
 * 注意：服务卡片实际运行需要在鸿蒙真机或模拟器环境中测试，
 * 此处为完整的接口结构和模拟实现。
 */

// ============================================
// 类型定义
// ============================================

/**
 * 最近在读/在看的条目项
 */
interface RecentItem {
  /** 条目标题 */
  title: string
  /** 条目副标题 */
  subtitle: string
  /** 条目类型 */
  type: string
}

/**
 * 服务卡片展示数据接口
 */
export interface WidgetData {
  /** 本月读书数量 */
  monthBooks: number
  /** 本月观影数量 */
  monthMovies: number
  /** 本月播客数量 */
  monthPodcasts: number
  /** 本月展览数量 */
  monthExhibitions: number
  /** 最近在读/在看的 3 个条目 */
  recentItems: Array<RecentItem>
  /** 卡片尺寸：'2*2' 或 '4*2' */
  dimension: string
}

/**
 * CultureBox 条目数据结构（与 App 端保持一致）
 */
interface Entry {
  entryId: string
  type: 'book' | 'movie' | 'podcast' | 'exhibition'
  title: string
  subtitle: string
  date: string
  createdAt: number
}

// ============================================
// 本地存储键名（与 App 端保持一致）
// ============================================

const STORAGE_KEYS = {
  ENTRIES: 'culturebox_db_entries',
  WIDGET_DATA: 'culturebox_widget_data',
  WIDGET_CLICK_TIME: 'culturebox_widget_click_time'
}

// ============================================
// 内部工具函数
// ============================================

/**
 * 从本地存储读取对象数据
 * @param key 存储键名
 * @returns 解析后的对象，失败返回 null
 */
function getStorageObject<T>(key: string): T | null {
  try {
    const raw = uni.getStorageSync(key)
    if (!raw) return null
    // uni.getStorageSync 在不同平台可能返回字符串或已解析对象
    if (typeof raw === 'string') return JSON.parse(raw) as T
    return raw as T
  } catch (e) {
    console.error('[culturebox-widget] getStorageObject error:', e)
    return null
  }
}

/**
 * 获取本月各类型条目统计
 * @returns 本月统计对象
 */
function getMonthStats(): { monthBooks: number; monthMovies: number; monthPodcasts: number; monthExhibitions: number } {
  try {
    const entries = getStorageObject<Record<string, Entry>>(STORAGE_KEYS.ENTRIES)
    if (!entries) {
      return { monthBooks: 0, monthMovies: 0, monthPodcasts: 0, monthExhibitions: 0 }
    }

    const now = new Date()
    const currentMonth = now.getMonth()
    const currentYear = now.getFullYear()

    const monthEntries = Object.values(entries).filter((entry: Entry) => {
      const d = new Date(entry.date)
      return d.getFullYear() === currentYear && d.getMonth() === currentMonth
    })

    return {
      monthBooks: monthEntries.filter((e: Entry) => e.type === 'book').length,
      monthMovies: monthEntries.filter((e: Entry) => e.type === 'movie').length,
      monthPodcasts: monthEntries.filter((e: Entry) => e.type === 'podcast').length,
      monthExhibitions: monthEntries.filter((e: Entry) => e.type === 'exhibition').length
    }
  } catch (e) {
    console.error('[culturebox-widget] getMonthStats error:', e)
    return { monthBooks: 0, monthMovies: 0, monthPodcasts: 0, monthExhibitions: 0 }
  }
}

/**
 * 获取最近在读/在看的 3 个条目
 * @returns 最近条目数组
 */
function getRecentItems(): Array<RecentItem> {
  try {
    const entries = getStorageObject<Record<string, Entry>>(STORAGE_KEYS.ENTRIES)
    if (!entries) return []

    const items = Object.values(entries)
      .sort((a: Entry, b: Entry) => (b.createdAt || 0) - (a.createdAt || 0))
      .slice(0, 3)
      .map((entry: Entry) => ({
        title: entry.title || '未知条目',
        subtitle: entry.subtitle || '',
        type: entry.type || 'book'
      }))

    return items
  } catch (e) {
    console.error('[culturebox-widget] getRecentItems error:', e)
    return []
  }
}

/**
 * 条目类型中文映射表
 */
const ENTRY_TYPE_MAP: Record<string, string> = {
  'book': '书',
  'movie': '电影',
  'podcast': '播客',
  'exhibition': '展览'
}

/**
 * 获取条目类型的中文名称
 * @param type 条目类型标识
 * @returns 中文名称
 */
function getEntryTypeName(type: string): string {
  return ENTRY_TYPE_MAP[type] || '其他'
}

// ============================================
// 对外接口
// ============================================

/**
 * 获取卡片展示数据
 *
 * 从 App 本地存储中读取本月条目统计和最近在读/在看的条目，
 * 组装为 WidgetData 返回给服务卡片使用。
 *
 * @returns WidgetData 卡片展示数据
 */
export function getWidgetData(): WidgetData {
  const stats = getMonthStats()
  const recentItems = getRecentItems()

  const data: WidgetData = {
    monthBooks: stats.monthBooks,
    monthMovies: stats.monthMovies,
    monthPodcasts: stats.monthPodcasts,
    monthExhibitions: stats.monthExhibitions,
    recentItems: recentItems,
    dimension: '2*2'
  }

  // 将当前卡片数据缓存到本地，供卡片刷新时使用
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_DATA, data)
  } catch (e) {
    console.error('[culturebox-widget] cache widget data error:', e)
  }

  console.log('[culturebox-widget] getWidgetData:', JSON.stringify(data))
  return data
}

/**
 * 更新服务卡片内容
 *
 * 将最新的 WidgetData 同步到鸿蒙服务卡片。
 * 实际实现中需要调用鸿蒙 FormManager 的 updateForm 接口。
 *
 * @param data 最新的卡片展示数据（可仅传入部分字段，缺失字段从本地存储补全）
 */
export function updateWidget(data: Partial<WidgetData>): void {
  // 1. 补全缺失字段
  const stats = getMonthStats()
  const recentItems = getRecentItems()

  const fullData: WidgetData = {
    monthBooks: data.monthBooks ?? stats.monthBooks,
    monthMovies: data.monthMovies ?? stats.monthMovies,
    monthPodcasts: data.monthPodcasts ?? stats.monthPodcasts,
    monthExhibitions: data.monthExhibitions ?? stats.monthExhibitions,
    recentItems: data.recentItems || recentItems,
    dimension: data.dimension || '2*2'
  }

  // 2. 缓存到本地存储
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_DATA, fullData)
  } catch (e) {
    console.error('[culturebox-widget] cache widget data error:', e)
  }

  // 3. 调用鸿蒙原生接口更新服务卡片（模拟实现）
  // 实际真机环境中，需要通过 FormManager 获取当前 formId 并触发更新
  // 示例：
  // import formManager from '@ohos.app.form.formManager';
  // formManager.updateForm(formId, formBindingData.createFormBindingData(fullData));

  console.log('[culturebox-widget] updateWidget:', JSON.stringify(fullData))

  // 4. 触发自定义事件通知卡片刷新（UTS 层向 ArkUI 卡片通信）
  try {
    uni.$emit('culturebox_widget_data_changed', fullData)
  } catch (e) {
    console.error('[culturebox-widget] emit widget update error:', e)
  }
}

/**
 * 卡片点击处理
 *
 * 用户点击服务卡片时，唤起 CultureBox App 并跳转到首页。
 * 实际实现中需要调用鸿蒙 Want 机制进行应用跳转。
 */
export function onWidgetClick(): void {
  console.log('[culturebox-widget] widget clicked, launching app...')

  // 记录点击时间，App 启动时读取并跳转对应页面
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_CLICK_TIME, Date.now())
    uni.setStorageSync('culturebox_widget_target_page', '/pages/index/index')
  } catch (e) {
    console.error('[culturebox-widget] record click time error:', e)
  }

  // 实际真机环境中，应使用如下方式启动应用：
  // import Want from '@ohos.app.ability.Want';
  // const want: Want = {
  //   bundleName: 'com.culturebox.app',
  //   abilityName: 'EntryAbility',
  //   parameters: {
  //     fromWidget: true,
  //     targetPage: '/pages/index/index'
  //   }
  // };
  // context.startAbility(want);
}

/**
 * 卡片生命周期：首次创建
 *
 * 服务卡片被添加到桌面/负一屏时调用，初始化卡片数据。
 */
export function onWidgetCreate(): void {
  console.log('[culturebox-widget] widget created')
  getWidgetData()
}

/**
 * 卡片生命周期：销毁
 *
 * 服务卡片被移除时调用，执行清理操作。
 */
export function onWidgetDestroy(): void {
  console.log('[culturebox-widget] widget destroyed')
  try {
    uni.removeStorageSync(STORAGE_KEYS.WIDGET_DATA)
  } catch (e) {
    console.error('[culturebox-widget] cleanup error:', e)
  }
}

/**
 * 快捷操作处理
 *
 * 用户点击卡片上的快捷操作按钮时触发。
 * 支持 action: 'addEntry'（新增条目）。
 *
 * @param action 快捷操作标识
 */
export function onQuickAction(action: string): void {
  console.log('[culturebox-widget] quick action:', action)

  try {
    uni.setStorageSync('culturebox_widget_quick_action', action)
    uni.setStorageSync(STORAGE_KEYS.WIDGET_CLICK_TIME, Date.now())
  } catch (e) {
    console.error('[culturebox-widget] record quick action error:', e)
  }

  if (action === 'addEntry') {
    try {
      uni.setStorageSync('culturebox_widget_target_page', '/pages/entry/create')
    } catch (e) {
      console.error('[culturebox-widget] set target page error:', e)
    }
  }

  // 实际真机环境中，通过 Want 机制启动应用并传递参数：
  // import Want from '@ohos.app.ability.Want';
  // const want: Want = {
  //   bundleName: 'com.culturebox.app',
  //   abilityName: 'EntryAbility',
  //   parameters: {
  //     fromWidget: true,
  //     quickAction: action
  //   }
  // };
  // context.startAbility(want);
}
