/**
 * AnglerMate 鸿蒙负一屏服务卡片 UTS 插件
 *
 * 本插件仅在鸿蒙端（APP-HARMONY）编译运行，提供服务卡片的数据获取、更新和点击跳转能力。
 * 由于 UTS 在鸿蒙端编译为 ArkTS，可直接调用鸿蒙原生 API。
 *
 * 注意：服务卡片实际运行需要在鸿蒙真机或模拟器环境中测试，
 * 此处为完整的接口结构和模拟实现。
 */

// ============================================
// 类型定义
// ============================================

/**
 * 服务卡片展示数据接口
 */
export interface WidgetData {
  /** 钓鱼指数（0-100） */
  fishingIndex: number
  /** 钓鱼指数等级描述（极佳/良好/一般/较差） */
  fishingLevel: string
  /** 当前温度（℃） */
  temperature: number
  /** 天气状况描述 */
  weatherDesc: string
  /** 最近钓点名称 */
  nearestSpotName: string
  /** 最近钓点距离（km） */
  nearestSpotDistance: number
  /** 风力描述 */
  windDesc: string
  /** 气压（hPa） */
  pressure: number
}

// ============================================
// 本地存储键名（与 App 端保持一致）
// ============================================

const STORAGE_KEYS = {
  WEATHER: 'anglermate_weather',
  SPOTS: 'anglermate_spots',
  USER_INFO: 'userInfo',
  WIDGET_DATA: 'anglermate_widget_data'
}

// ============================================
// 内部工具函数
// ============================================

/**
 * 从本地存储读取对象数据
 * @param key 存储键名
 * @returns 解析后的对象，失败返回 null
 */
function getStorageObject<T>(key: string): T | null {
  try {
    const raw = uni.getStorageSync(key)
    if (!raw) return null
    // uni.getStorageSync 在不同平台可能返回字符串或已解析对象
    if (typeof raw === 'string') return JSON.parse(raw) as T
    return raw as T
  } catch (e) {
    console.error('[anglermate-widget] getStorageObject error:', e)
    return null
  }
}

/**
 * 根据天气数据计算钓鱼指数（0-100）
 * 综合温度、气压、风力等因素
 */
function calcFishingIndex(weather: Record<string, any>): number {
  let score = 50

  // 温度评分：15-25℃ 最佳
  const temp = (weather.temperature as number) || 20
  if (temp >= 15 && temp <= 25) {
    score += 20
  } else if (temp >= 10 && temp <= 30) {
    score += 10
  } else {
    score -= 10
  }

  // 气压评分：1000-1025hPa 较佳
  const pressure = (weather.pressure as number) || 1013
  if (pressure >= 1000 && pressure <= 1025) {
    score += 15
  } else {
    score -= 5
  }

  // 风力评分：微风最佳
  const windLevel = (weather.windLevel as number) || 3
  if (windLevel <= 3) {
    score += 15
  } else if (windLevel <= 5) {
    score += 5
  } else {
    score -= 15
  }

  return Math.max(0, Math.min(100, score))
}

/**
 * 将钓鱼指数转为等级描述
 */
function getFishingLevel(index: number): string {
  if (index >= 80) return '极佳'
  if (index >= 60) return '良好'
  if (index >= 40) return '一般'
  return '较差'
}

/**
 * 获取天气信息
 */
function getWeatherInfo(): Record<string, any> | null {
  return getStorageObject<Record<string, any>>(STORAGE_KEYS.WEATHER)
}

/**
 * 获取最近钓点信息
 */
function getNearestSpot(): { name: string; distance: number } {
  const spots = getStorageObject<Record<string, any>>(STORAGE_KEYS.SPOTS)
  if (!spots) return { name: '暂无钓点', distance: 0 }

  const spotList = Object.values(spots)
  if (spotList.length === 0) return { name: '暂无钓点', distance: 0 }

  // 按距离排序，取最近的钓点
  const sorted = spotList.sort((a: any, b: any) => {
    const distA = (a.distance as number) || 999
    const distB = (b.distance as number) || 999
    return distA - distB
  })

  const nearest = sorted[0] as any
  return {
    name: nearest.name || '未命名钓点',
    distance: (nearest.distance as number) || 0
  }
}

// ============================================
// 对外接口
// ============================================

/**
 * 获取卡片展示数据
 *
 * 从 App 本地存储中读取天气数据和钓点信息，
 * 组装为 WidgetData 返回给服务卡片使用。
 *
 * @returns WidgetData 卡片展示数据
 */
export function getWidgetData(): WidgetData {
  const weather = getWeatherInfo()
  const spot = getNearestSpot()

  const temperature = (weather?.temperature as number) || 0
  const weatherDesc = (weather?.description as string) || '暂无天气数据'
  const windDesc = (weather?.windDesc as string) || '微风'
  const pressure = (weather?.pressure as number) || 1013

  const fishingIndex = weather ? calcFishingIndex(weather) : 0
  const fishingLevel = getFishingLevel(fishingIndex)

  const data: WidgetData = {
    fishingIndex,
    fishingLevel,
    temperature,
    weatherDesc,
    nearestSpotName: spot.name,
    nearestSpotDistance: spot.distance,
    windDesc,
    pressure
  }

  // 将当前卡片数据缓存到本地，供卡片刷新时使用
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_DATA, data)
  } catch (e) {
    console.error('[anglermate-widget] cache widget data error:', e)
  }

  console.log('[anglermate-widget] getWidgetData:', JSON.stringify(data))
  return data
}

/**
 * 更新服务卡片内容
 *
 * 将最新的 WidgetData 同步到鸿蒙服务卡片。
 * 实际实现中需要调用鸿蒙 FormManager 的 updateForm 接口。
 *
 * @param data 最新的卡片展示数据
 */
export function updateWidget(data: WidgetData): void {
  // 1. 先缓存到本地存储
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_DATA, data)
  } catch (e) {
    console.error('[anglermate-widget] cache widget data error:', e)
  }

  // 2. 调用鸿蒙原生接口更新服务卡片（模拟实现）
  // 实际真机环境中，需要通过 FormManager 获取当前 formId 并触发更新
  // 示例：
  // import formManager from '@ohos.app.form.formManager';
  // formManager.updateForm(formId, formBindingData.createFormBindingData(data));

  console.log('[anglermate-widget] updateWidget:', JSON.stringify(data))

  // 触发自定义事件通知卡片刷新（UTS 层向 ArkUI 卡片通信）
  try {
    uni.$emit('anglermate_widget_data_changed', data)
  } catch (e) {
    console.error('[anglermate-widget] emit widget update error:', e)
  }
}

/**
 * 卡片点击处理 - 跳转首页
 *
 * 用户点击服务卡片主体时，唤起 AnglerMate App 并跳转到首页。
 * 实际实现中需要调用鸿蒙 Want 机制进行应用跳转。
 */
export function onWidgetClick(): void {
  console.log('[anglermate-widget] widget clicked, launching app to home...')

  try {
    uni.setStorageSync('anglermate_widget_click', {
      time: Date.now(),
      target: '/pages/index/index'
    })
  } catch (e) {
    console.error('[anglermate-widget] record click error:', e)
  }

  // 实际真机环境中，应使用如下方式启动应用：
  // import Want from '@ohos.app.ability.Want';
  // const want: Want = {
  //   bundleName: 'com.anglermate.app',
  //   abilityName: 'EntryAbility',
  //   parameters: {
  //     fromWidget: true,
  //     targetPage: '/pages/index/index'
  //   }
  // };
  // context.startAbility(want);
}

/**
 * 卡片点击处理 - 跳转记录渔获页
 *
 * 用户点击卡片快捷操作时，唤起 App 并跳转到记录渔获页面。
 */
export function onWidgetClickAddCatch(): void {
  console.log('[anglermate-widget] widget clicked, launching app to add catch...')

  try {
    uni.setStorageSync('anglermate_widget_click', {
      time: Date.now(),
      target: '/pages/catches/add'
    })
  } catch (e) {
    console.error('[anglermate-widget] record click error:', e)
  }

  // 实际真机环境中，应使用如下方式启动应用：
  // import Want from '@ohos.app.ability.Want';
  // const want: Want = {
  //   bundleName: 'com.anglermate.app',
  //   abilityName: 'EntryAbility',
  //   parameters: {
  //     fromWidget: true,
  //     targetPage: '/pages/catches/add'
  //   }
  // };
  // context.startAbility(want);
}

/**
 * 卡片生命周期：首次创建
 *
 * 服务卡片被添加到桌面/负一屏时调用，初始化卡片数据。
 */
export function onWidgetCreate(): void {
  console.log('[anglermate-widget] widget created')
  getWidgetData()
}

/**
 * 卡片生命周期：销毁
 *
 * 服务卡片被移除时调用，执行清理操作。
 */
export function onWidgetDestroy(): void {
  console.log('[anglermate-widget] widget destroyed')
  try {
    uni.removeStorageSync(STORAGE_KEYS.WIDGET_DATA)
  } catch (e) {
    console.error('[anglermate-widget] cleanup error:', e)
  }
}
