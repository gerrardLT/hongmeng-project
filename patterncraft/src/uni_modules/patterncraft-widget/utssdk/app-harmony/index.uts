/**
 * PatternCraft 鸿蒙负一屏服务卡片 UTS 插件
 *
 * 本插件仅在鸿蒙端（APP-HARMONY）编译运行，提供服务卡片的数据获取、更新和点击跳转能力。
 * 由于 UTS 在鸿蒙端编译为 ArkTS，可直接调用鸿蒙原生 API。
 *
 * 注意：服务卡片实际运行需要在鸿蒙真机或模拟器环境中测试，
 * 此处为完整的接口结构和模拟实现。
 */

// ============================================
// 类型定义
// ============================================

/**
 * 最近使用的纹样项
 */
interface RecentPatternItem {
  /** 纹样名称 */
  name: string
  /** 纹样主色调 hex 值 */
  primaryColor: string
  /** 纹样类型（如：云纹、回纹、缠枝等） */
  type: string
}

/**
 * 服务卡片展示数据接口
 */
export interface WidgetData {
  /** 每日推荐纹样名称 */
  dailyPatternName: string
  /** 每日推荐纹样缩略预览色值 */
  dailyPatternPreview: string
  /** 最近使用的 3 个纹样 */
  recentPatterns: Array<RecentPatternItem>
  /** 用户累计创作数量 */
  totalWorks: number
  /** 卡片尺寸：'2*2' 或 '4*2' */
  dimension: string
}

// ============================================
// 本地存储键名（与 App 端保持一致）
// ============================================

const STORAGE_KEYS = {
  DAILY: 'patterncraft_daily',
  RECENT: 'patterncraft_recent',
  STATS: 'patterncraft_stats',
  WIDGET_DATA: 'patterncraft_widget_data',
  WIDGET_CLICK_TIME: 'patterncraft_widget_click_time'
}

// ============================================
// 内部工具函数
// ============================================

/**
 * 纹样类型中文映射表
 */
const PATTERN_TYPE_MAP: Record<string, string> = {
  'cloud': '云纹',
  'meander': '回纹',
  'scroll': '缠枝纹',
  'dragon': '龙纹',
  'phoenix': '凤纹',
  'lotus': '莲花纹',
  'ruyi': '如意纹',
  'bat': '蝠纹',
  'geometric': '几何纹',
  'wave': '水波纹'
}

/**
 * 从本地存储读取对象数据
 * @param key 存储键名
 * @returns 解析后的对象，失败返回 null
 */
function getStorageObject<T>(key: string): T | null {
  try {
    const raw = uni.getStorageSync(key)
    if (!raw) return null
    // uni.getStorageSync 在不同平台可能返回字符串或已解析对象
    if (typeof raw === 'string') return JSON.parse(raw) as T
    return raw as T
  } catch (e) {
    console.error('[patterncraft-widget] getStorageObject error:', e)
    return null
  }
}

/**
 * 从本地存储读取每日推荐纹样
 * @returns 每日纹样名称和预览色值
 */
function getDailyPattern(): { name: string; preview: string } {
  try {
    const daily = getStorageObject<Record<string, any>>(STORAGE_KEYS.DAILY)
    if (daily) {
      return {
        name: (daily.name as string) || '祥云纹',
        preview: (daily.previewColor as string) || '#C41A16'
      }
    }
  } catch (e) {
    console.error('[patterncraft-widget] getDailyPattern error:', e)
  }
  return {
    name: '祥云纹',
    preview: '#C41A16'
  }
}

/**
 * 从本地存储获取最近使用的 3 个纹样
 * @returns 最近纹样数组
 */
function getRecentPatterns(): Array<RecentPatternItem> {
  try {
    const recent = getStorageObject<Array<Record<string, any>>>(STORAGE_KEYS.RECENT)
    if (!recent || !Array.isArray(recent)) return []

    return recent
      .slice(0, 3)
      .map((item: any) => ({
        name: (item.name as string) || '未知纹样',
        primaryColor: (item.primaryColor as string) || '#C41A16',
        type: getPatternTypeName((item.type as string) || '')
      }))
  } catch (e) {
    console.error('[patterncraft-widget] getRecentPatterns error:', e)
    return []
  }
}

/**
 * 从本地存储获取用户创作统计
 * @returns 累计创作数量
 */
function getTotalWorks(): number {
  try {
    const stats = getStorageObject<Record<string, any>>(STORAGE_KEYS.STATS)
    if (stats) {
      return (stats.totalWorks as number) || 0
    }
  } catch (e) {
    console.error('[patterncraft-widget] getTotalWorks error:', e)
  }
  return 0
}

/**
 * 获取纹样类型的中文名称
 * @param type 纹样类型标识
 * @returns 中文名称
 */
function getPatternTypeName(type: string): string {
  return PATTERN_TYPE_MAP[type] || type || '传统纹样'
}

// ============================================
// 对外接口
// ============================================

/**
 * 获取卡片展示数据
 *
 * 从 App 本地存储中读取每日纹样、最近使用纹样和创作统计，
 * 组装为 WidgetData 返回给服务卡片使用。
 *
 * @returns WidgetData 卡片展示数据
 */
export function getWidgetData(): WidgetData {
  const daily = getDailyPattern()
  const recentPatterns = getRecentPatterns()
  const totalWorks = getTotalWorks()

  const data: WidgetData = {
    dailyPatternName: daily.name,
    dailyPatternPreview: daily.preview,
    recentPatterns: recentPatterns,
    totalWorks: totalWorks,
    dimension: '2*2'
  }

  // 将当前卡片数据缓存到本地，供卡片刷新时使用
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_DATA, data)
  } catch (e) {
    console.error('[patterncraft-widget] cache widget data error:', e)
  }

  console.log('[patterncraft-widget] getWidgetData:', JSON.stringify(data))
  return data
}

/**
 * 更新服务卡片内容
 *
 * 将最新的 WidgetData 同步到鸿蒙服务卡片。
 * 实际实现中需要调用鸿蒙 FormManager 的 updateForm 接口。
 *
 * @param data 最新的卡片展示数据（可仅传入部分字段，缺失字段从本地存储补全）
 */
export function updateWidget(data: Partial<WidgetData>): void {
  // 1. 补全缺失字段
  const daily = getDailyPattern()
  const recentPatterns = getRecentPatterns()
  const totalWorks = getTotalWorks()

  const fullData: WidgetData = {
    dailyPatternName: data.dailyPatternName || daily.name,
    dailyPatternPreview: data.dailyPatternPreview || daily.preview,
    recentPatterns: data.recentPatterns || recentPatterns,
    totalWorks: data.totalWorks ?? totalWorks,
    dimension: data.dimension || '2*2'
  }

  // 2. 缓存到本地存储
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_DATA, fullData)
  } catch (e) {
    console.error('[patterncraft-widget] cache widget data error:', e)
  }

  // 3. 调用鸿蒙原生接口更新服务卡片（模拟实现）
  // 实际真机环境中，需要通过 FormManager 获取当前 formId 并触发更新
  // 示例：
  // import formManager from '@ohos.app.form.formManager';
  // formManager.updateForm(formId, formBindingData.createFormBindingData(fullData));

  console.log('[patterncraft-widget] updateWidget:', JSON.stringify(fullData))

  // 4. 触发自定义事件通知卡片刷新（UTS 层向 ArkUI 卡片通信）
  try {
    uni.$emit('patterncraft_widget_data_changed', fullData)
  } catch (e) {
    console.error('[patterncraft-widget] emit widget update error:', e)
  }
}

/**
 * 卡片点击处理
 *
 * 用户点击服务卡片时，唤起 PatternCraft App 并跳转到纹样创作页面。
 * 实际实现中需要调用鸿蒙 Want 机制进行应用跳转。
 */
export function onWidgetClick(): void {
  console.log('[patterncraft-widget] widget clicked, launching app...')

  // 记录点击时间，App 启动时读取并跳转对应页面
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_CLICK_TIME, Date.now())
    uni.setStorageSync('patterncraft_widget_target_page', '/pages/editor/index')
  } catch (e) {
    console.error('[patterncraft-widget] record click time error:', e)
  }

  // 实际真机环境中，应使用如下方式启动应用：
  // import Want from '@ohos.app.ability.Want';
  // const want: Want = {
  //   bundleName: 'com.patterncraft.app',
  //   abilityName: 'EntryAbility',
  //   parameters: {
  //     fromWidget: true,
  //     targetPage: '/pages/editor/index'
  //   }
  // };
  // context.startAbility(want);
}

/**
 * 卡片生命周期：首次创建
 *
 * 服务卡片被添加到桌面/负一屏时调用，初始化卡片数据。
 */
export function onWidgetCreate(): void {
  console.log('[patterncraft-widget] widget created')
  getWidgetData()
}

/**
 * 卡片生命周期：销毁
 *
 * 服务卡片被移除时调用，执行清理操作。
 */
export function onWidgetDestroy(): void {
  console.log('[patterncraft-widget] widget destroyed')
  try {
    uni.removeStorageSync(STORAGE_KEYS.WIDGET_DATA)
  } catch (e) {
    console.error('[patterncraft-widget] cleanup error:', e)
  }
}

/**
 * 快捷操作处理
 *
 * 用户点击卡片上的快捷操作按钮时触发。
 * 支持 action: 'quickDesign'（快速设计）、'viewGallery'（浏览纹样库）。
 *
 * @param action 快捷操作标识
 */
export function onQuickAction(action: string): void {
  console.log('[patterncraft-widget] quick action:', action)

  try {
    uni.setStorageSync('patterncraft_widget_quick_action', action)
    uni.setStorageSync(STORAGE_KEYS.WIDGET_CLICK_TIME, Date.now())
  } catch (e) {
    console.error('[patterncraft-widget] record quick action error:', e)
  }

  if (action === 'quickDesign') {
    // 快速设计：App 启动时读取此标记，自动跳转到创作页面
    try {
      uni.setStorageSync('patterncraft_widget_target_page', '/pages/editor/index')
    } catch (e) {
      console.error('[patterncraft-widget] set target page error:', e)
    }
  } else if (action === 'viewGallery') {
    // 浏览纹样库
    try {
      uni.setStorageSync('patterncraft_widget_target_page', '/pages/gallery/index')
    } catch (e) {
      console.error('[patterncraft-widget] set target page error:', e)
    }
  }

  // 实际真机环境中，通过 Want 机制启动应用并传递参数：
  // import Want from '@ohos.app.ability.Want';
  // const want: Want = {
  //   bundleName: 'com.patterncraft.app',
  //   abilityName: 'EntryAbility',
  //   parameters: {
  //     fromWidget: true,
  //     quickAction: action
  //   }
  // };
  // context.startAbility(want);
}
