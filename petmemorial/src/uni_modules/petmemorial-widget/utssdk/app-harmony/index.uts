/**
 * PetMemorial 鸿蒙负一屏服务卡片 UTS 插件
 *
 * 本插件仅在鸿蒙端（APP-HARMONY）编译运行，提供服务卡片的数据获取、更新和点击跳转能力。
 * 由于 UTS 在鸿蒙端编译为 ArkTS，可直接调用鸿蒙原生 API。
 *
 * 支持三种服务卡片：
 * 1. 预约提醒卡片 — 显示即将到来的预约信息
 * 2. 制作进度卡片 — 显示当前纪念品制作进度
 * 3. 宠物纪念日提醒卡片 — 提醒即将到来的宠物纪念日
 *
 * 注意：服务卡片实际运行需要在鸿蒙真机或模拟器环境中测试，
 * 此处为完整的接口结构和模拟实现。
 */

// ============================================
// 类型定义
// ============================================

/**
 * 预约提醒卡片展示数据
 */
export interface BookingWidgetData {
  /** 工作室名称 */
  studioName: string
  /** 预约时间（格式：MM-DD HH:mm） */
  bookingTime: string
  /** 纪念品种类（如：爪印相框、毛发纪念品等） */
  memorialType: string
}

/**
 * 制作进度卡片展示数据
 */
export interface ProgressWidgetData {
  /** 当前阶段（如：采集中、制作中、已完成） */
  currentStage: string
  /** 进度百分比（0-100） */
  progressPercent: number
  /** 预计完成时间（格式：MM-DD） */
  estimatedCompletion: string
}

/**
 * 宠物纪念日提醒卡片展示数据
 */
export interface AnniversaryWidgetData {
  /** 宠物名称 */
  petName: string
  /** 纪念日类型（如：生日、领养纪念日） */
  anniversaryType: string
  /** 距离天数描述（如：3天后、今天） */
  daysUntil: string
}

// ============================================
// 本地存储键名（与 App 端保持一致）
// ============================================

const STORAGE_KEYS = {
  AUTH: 'petmemorial_auth',
  BOOKINGS: 'petmemorial_bookings',
  PROGRESSES: 'petmemorial_progresses',
  PETS: 'petmemorial_pets',
  ANNIVERSARIES: 'petmemorial_anniversaries',
  STUDIOS: 'petmemorial_studios',
  MEMORIALS: 'petmemorial_memorials',
  USER_INFO: 'petmemorial_user_info',
  WIDGET_BOOKING_DATA: 'petmemorial_widget_booking_data',
  WIDGET_PROGRESS_DATA: 'petmemorial_widget_progress_data',
  WIDGET_ANNIVERSARY_DATA: 'petmemorial_widget_anniversary_data'
}

// ============================================
// 内部工具函数
// ============================================

/**
 * 从本地存储读取对象数据
 * @param key 存储键名
 * @returns 解析后的对象，失败返回 null
 */
function getStorageObject<T>(key: string): T | null {
  try {
    const raw = uni.getStorageSync(key)
    if (!raw) return null
    if (typeof raw === 'string') return JSON.parse(raw) as T
    return raw as T
  } catch (e) {
    console.error('[petmemorial-widget] getStorageObject error:', e)
    return null
  }
}

/**
 * 获取当前登录用户 ID
 */
function getCurrentUserId(): string {
  try {
    const auth = uni.getStorageSync(STORAGE_KEYS.AUTH) as { userId?: string } | null
    if (auth && typeof auth === 'object' && auth.userId) {
      return auth.userId
    }
    const userInfo = uni.getStorageSync(STORAGE_KEYS.USER_INFO) as { userId?: string } | null
    return userInfo?.userId || ''
  } catch (e) {
    console.error('[petmemorial-widget] getCurrentUserId error:', e)
    return ''
  }
}

/**
 * 格式化日期为 MM-DD HH:mm 格式
 */
function formatDateTime(dateStr: string, timeSlot: string): string {
  try {
    const date = new Date(dateStr)
    const month = String(date.getMonth() + 1).padStart(2, '0')
    const day = String(date.getDate()).padStart(2, '0')
    return `${month}-${day} ${timeSlot}`
  } catch (e) {
    return '--'
  }
}

/**
 * 格式化日期为 MM-DD 格式
 */
function formatDate(timestamp: number): string {
  try {
    const date = new Date(timestamp)
    const month = String(date.getMonth() + 1).padStart(2, '0')
    const day = String(date.getDate()).padStart(2, '0')
    return `${month}-${day}`
  } catch (e) {
    return '--'
  }
}

// ============================================
// 预约提醒卡片数据
// ============================================

/**
 * 获取即将到来的预约信息
 */
function getUpcomingBooking(): BookingWidgetData {
  const bookings = getStorageObject<Record<string, any>>(STORAGE_KEYS.BOOKINGS)
  if (!bookings) {
    return {
      studioName: '暂无预约',
      bookingTime: '--',
      memorialType: '--'
    }
  }

  const userId = getCurrentUserId()
  if (!userId) {
    return {
      studioName: '暂无预约',
      bookingTime: '--',
      memorialType: '--'
    }
  }

  const now = Date.now()

  // 筛选当前用户未取消的预约，按日期排序
  const upcomingBookings = Object.values(bookings)
    .filter((b: any) => b.userId === userId && b.status !== 'cancelled')
    .sort((a: any, b: any) => {
      const dateA = new Date(a.date).getTime()
      const dateB = new Date(b.date).getTime()
      return dateA - dateB
    })

  if (upcomingBookings.length === 0) {
    return {
      studioName: '暂无预约',
      bookingTime: '--',
      memorialType: '--'
    }
  }

  const next = upcomingBookings[0] as any

  // 查找工作室名称
  let studioName = '未知工作室'
  const studios = getStorageObject<Record<string, any>>(STORAGE_KEYS.STUDIOS)
  if (studios && next.studioId) {
    const studio = studios[next.studioId]
    if (studio && studio.name) {
      studioName = studio.name
    }
  }

  // 查找纪念品种类名称
  let memorialType = '定制纪念品'
  const memorials = getStorageObject<Record<string, any>>(STORAGE_KEYS.MEMORIALS)
  if (memorials && next.typeId) {
    const memorial = memorials[next.typeId]
    if (memorial && memorial.name) {
      memorialType = memorial.name
    }
  }

  return {
    studioName,
    bookingTime: formatDateTime(next.date, next.timeSlot || '--'),
    memorialType
  }
}

// ============================================
// 制作进度卡片数据
// ============================================

/**
 * 获取当前制作进度
 */
function getCurrentProgress(): ProgressWidgetData {
  const bookings = getStorageObject<Record<string, any>>(STORAGE_KEYS.BOOKINGS)
  const progresses = getStorageObject<Record<string, any>>(STORAGE_KEYS.PROGRESSES)

  if (!bookings || !progresses) {
    return {
      currentStage: '暂无订单',
      progressPercent: 0,
      estimatedCompletion: '--'
    }
  }

  const userId = getCurrentUserId()
  if (!userId) {
    return {
      currentStage: '暂无订单',
      progressPercent: 0,
      estimatedCompletion: '--'
    }
  }

  // 找到当前用户最近的非取消预约
  const userBookings = Object.values(bookings)
    .filter((b: any) => b.userId === userId && b.status !== 'cancelled')
    .sort((a: any, b: any) => (b.createdAt || 0) - (a.createdAt || 0))

  if (userBookings.length === 0) {
    return {
      currentStage: '暂无订单',
      progressPercent: 0,
      estimatedCompletion: '--'
    }
  }

  // 查找该预约的进度记录
  const stageLabels: Record<string, string> = {
    'collected': '采集中',
    'design-confirmed': '设计中',
    'manufacturing': '制作中',
    'quality-check': '质检中',
    'ready-pickup': '待取件',
    'shipped': '已发货'
  }

  const progressMap: Record<string, number> = {
    'collected': 16,
    'design-confirmed': 33,
    'manufacturing': 50,
    'quality-check': 66,
    'ready-pickup': 83,
    'shipped': 100
  }

  for (const booking of userBookings) {
    const bookingProgresses = Object.values(progresses)
      .filter((p: any) => p.bookingId === (booking as any).bookingId)
      .sort((a: any, b: any) => (a.updateTime || 0) - (b.updateTime || 0))

    if (bookingProgresses.length === 0) continue

    const latest = bookingProgresses[bookingProgresses.length - 1] as any
    const stage = latest.stage || 'manufacturing'

    return {
      currentStage: stageLabels[stage] || '制作中',
      progressPercent: progressMap[stage] || 30,
      estimatedCompletion: latest.estimatedCompletionTime
        ? formatDate(latest.estimatedCompletionTime)
        : '--'
    }
  }

  return {
    currentStage: '暂无进度',
    progressPercent: 0,
    estimatedCompletion: '--'
  }
}

// ============================================
// 宠物纪念日提醒卡片数据
// ============================================

/**
 * 获取下一个宠物纪念日提醒
 */
function getNextAnniversary(): AnniversaryWidgetData {
  const anniversaries = getStorageObject<Record<string, any>>(STORAGE_KEYS.ANNIVERSARIES)
  const pets = getStorageObject<Record<string, any>>(STORAGE_KEYS.PETS)

  if (!anniversaries) {
    return {
      petName: '爱宠',
      anniversaryType: '暂无提醒',
      daysUntil: '--'
    }
  }

  const userId = getCurrentUserId()
  if (!userId) {
    return {
      petName: '爱宠',
      anniversaryType: '暂无提醒',
      daysUntil: '--'
    }
  }

  const now = new Date()
  const currentYear = now.getFullYear()

  // 筛选当前用户启用的纪念日，按距离当前日期排序
  const upcomingList: Array<{
    petName: string
    anniversaryType: string
    daysUntil: number
  }> = []

  const typeLabels: Record<string, string> = {
    'birthday': '生日',
    'adopt-day': '领养纪念日',
    'memorial-day': '纪念日',
    'custom': '纪念日'
  }

  for (const key in anniversaries) {
    const ann = anniversaries[key] as any
    if (ann.userId !== userId || !ann.enabled) continue

    const annDate = new Date(ann.date)
    const thisYearDate = new Date(currentYear, annDate.getMonth(), annDate.getDate())
    if (thisYearDate < new Date(now.getFullYear(), now.getMonth(), now.getDate())) {
      // 今年已过，算明年
      thisYearDate.setFullYear(currentYear + 1)
    }

    const diffMs = thisYearDate.getTime() - now.getTime()
    const diffDays = Math.ceil(diffMs / (24 * 60 * 60 * 1000))

    let petName = '爱宠'
    if (pets && ann.petId) {
      const pet = pets[ann.petId]
      if (pet && pet.name) {
        petName = pet.name
      }
    }

    upcomingList.push({
      petName,
      anniversaryType: typeLabels[ann.type] || '纪念日',
      daysUntil: diffDays
    })
  }

  if (upcomingList.length === 0) {
    return {
      petName: '爱宠',
      anniversaryType: '暂无提醒',
      daysUntil: '--'
    }
  }

  // 按天数升序排列
  upcomingList.sort((a, b) => a.daysUntil - b.daysUntil)
  const next = upcomingList[0]

  return {
    petName: next.petName,
    anniversaryType: next.anniversaryType,
    daysUntil: next.daysUntil === 0 ? '今天' : `${next.daysUntil}天后`
  }
}

// ============================================
// 对外接口
// ============================================

/**
 * 获取预约提醒卡片展示数据
 */
export function getBookingWidgetData(): BookingWidgetData {
  const data = getUpcomingBooking()

  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_BOOKING_DATA, data)
  } catch (e) {
    console.error('[petmemorial-widget] cache booking data error:', e)
  }

  console.log('[petmemorial-widget] getBookingWidgetData:', JSON.stringify(data))
  return data
}

/**
 * 获取制作进度卡片展示数据
 */
export function getProgressWidgetData(): ProgressWidgetData {
  const data = getCurrentProgress()

  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_PROGRESS_DATA, data)
  } catch (e) {
    console.error('[petmemorial-widget] cache progress data error:', e)
  }

  console.log('[petmemorial-widget] getProgressWidgetData:', JSON.stringify(data))
  return data
}

/**
 * 获取宠物纪念日提醒卡片展示数据
 */
export function getAnniversaryWidgetData(): AnniversaryWidgetData {
  const data = getNextAnniversary()

  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_ANNIVERSARY_DATA, data)
  } catch (e) {
    console.error('[petmemorial-widget] cache anniversary data error:', e)
  }

  console.log('[petmemorial-widget] getAnniversaryWidgetData:', JSON.stringify(data))
  return data
}

/**
 * 更新预约提醒服务卡片
 */
export function updateBookingWidget(data: BookingWidgetData): void {
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_BOOKING_DATA, data)
  } catch (e) {
    console.error('[petmemorial-widget] cache booking data error:', e)
  }

  console.log('[petmemorial-widget] updateBookingWidget:', JSON.stringify(data))

  try {
    uni.$emit('petmemorial_booking_widget_data_changed', data)
  } catch (e) {
    console.error('[petmemorial-widget] emit booking widget update error:', e)
  }
}

/**
 * 更新制作进度服务卡片
 */
export function updateProgressWidget(data: ProgressWidgetData): void {
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_PROGRESS_DATA, data)
  } catch (e) {
    console.error('[petmemorial-widget] cache progress data error:', e)
  }

  console.log('[petmemorial-widget] updateProgressWidget:', JSON.stringify(data))

  try {
    uni.$emit('petmemorial_progress_widget_data_changed', data)
  } catch (e) {
    console.error('[petmemorial-widget] emit progress widget update error:', e)
  }
}

/**
 * 更新宠物纪念日提醒服务卡片
 */
export function updateAnniversaryWidget(data: AnniversaryWidgetData): void {
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_ANNIVERSARY_DATA, data)
  } catch (e) {
    console.error('[petmemorial-widget] cache anniversary data error:', e)
  }

  console.log('[petmemorial-widget] updateAnniversaryWidget:', JSON.stringify(data))

  try {
    uni.$emit('petmemorial_anniversary_widget_data_changed', data)
  } catch (e) {
    console.error('[petmemorial-widget] emit anniversary widget update error:', e)
  }
}

/**
 * 统一更新所有服务卡片数据
 */
export function updateWidget(data: {
  booking?: BookingWidgetData | null
  progress?: ProgressWidgetData | null
  anniversary?: AnniversaryWidgetData | null
}): void {
  if (data.booking) {
    updateBookingWidget(data.booking)
  }
  if (data.progress) {
    updateProgressWidget(data.progress)
  }
  if (data.anniversary) {
    updateAnniversaryWidget(data.anniversary)
  }
}

/**
 * 卡片点击处理 — 跳转到预约页面
 */
export function onBookingWidgetClick(): void {
  console.log('[petmemorial-widget] booking widget clicked')
  try {
    uni.setStorageSync('petmemorial_widget_click_time', Date.now())
    uni.setStorageSync('petmemorial_widget_click_target', 'booking')
  } catch (e) {
    console.error('[petmemorial-widget] record click error:', e)
  }
}

/**
 * 卡片点击处理 — 跳转到进度页面
 */
export function onProgressWidgetClick(): void {
  console.log('[petmemorial-widget] progress widget clicked')
  try {
    uni.setStorageSync('petmemorial_widget_click_time', Date.now())
    uni.setStorageSync('petmemorial_widget_click_target', 'progress')
  } catch (e) {
    console.error('[petmemorial-widget] record click error:', e)
  }
}

/**
 * 卡片点击处理 — 跳转到纪念日页面
 */
export function onAnniversaryWidgetClick(): void {
  console.log('[petmemorial-widget] anniversary widget clicked')
  try {
    uni.setStorageSync('petmemorial_widget_click_time', Date.now())
    uni.setStorageSync('petmemorial_widget_click_target', 'anniversary')
  } catch (e) {
    console.error('[petmemorial-widget] record click error:', e)
  }
}

/**
 * 卡片生命周期：首次创建
 */
export function onWidgetCreate(): void {
  console.log('[petmemorial-widget] widget created')
  getBookingWidgetData()
  getProgressWidgetData()
  getAnniversaryWidgetData()
}

/**
 * 卡片生命周期：销毁
 */
export function onWidgetDestroy(): void {
  console.log('[petmemorial-widget] widget destroyed')
  try {
    uni.removeStorageSync(STORAGE_KEYS.WIDGET_BOOKING_DATA)
    uni.removeStorageSync(STORAGE_KEYS.WIDGET_PROGRESS_DATA)
    uni.removeStorageSync(STORAGE_KEYS.WIDGET_ANNIVERSARY_DATA)
  } catch (e) {
    console.error('[petmemorial-widget] cleanup error:', e)
  }
}
