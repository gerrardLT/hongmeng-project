/**
 * BabyKeepsake 鸿蒙负一屏服务卡片 UTS 插件
 *
 * 本插件仅在鸿蒙端（APP-HARMONY）编译运行，提供服务卡片的数据获取、更新和点击跳转能力。
 * 由于 UTS 在鸿蒙端编译为 ArkTS，可直接调用鸿蒙原生 API。
 *
 * 支持三种服务卡片：
 * 1. 预约提醒卡片 — 显示即将到来的预约信息
 * 2. 制作进度卡片 — 显示当前制作进度
 * 3. 里程碑提醒卡片 — 提醒宝宝成长节点
 *
 * 注意：服务卡片实际运行需要在鸿蒙真机或模拟器环境中测试，
 * 此处为完整的接口结构和模拟实现。
 */

// ============================================
// 类型定义
// ============================================

/**
 * 预约提醒卡片展示数据
 */
export interface BookingWidgetData {
  /** 工作室名称 */
  studioName: string
  /** 预约时间（格式：MM-DD HH:mm） */
  bookingTime: string
  /** 纪念品类型（如：手足印、胎毛笔等） */
  keepsakeType: string
}

/**
 * 制作进度卡片展示数据
 */
export interface ProgressWidgetData {
  /** 当前阶段（如：采集中、制作中、已完成） */
  currentStage: string
  /** 进度百分比（0-100） */
  progressPercent: number
  /** 预计完成时间（格式：MM-DD） */
  estimatedCompletion: string
}

/**
 * 里程碑提醒卡片展示数据
 */
export interface MilestoneWidgetData {
  /** 里程碑名称（如：3个月手印、6个月脚印） */
  milestoneName: string
  /** 宝宝月龄 */
  babyAge: string
  /** 下次采集时间（格式：MM-DD） */
  nextCollectTime: string
}

// ============================================
// 本地存储键名（与 App 端保持一致）
// ============================================

const STORAGE_KEYS = {
  BOOKINGS: 'babykeepsake_db_bookings',
  ORDERS: 'babykeepsake_db_orders',
  BABY_INFO: 'babykeepsake_db_baby_info',
  MILESTONES: 'babykeepsake_db_milestones',
  USER_INFO: 'userInfo',
  WIDGET_BOOKING_DATA: 'babykeepsake_widget_booking_data',
  WIDGET_PROGRESS_DATA: 'babykeepsake_widget_progress_data',
  WIDGET_MILESTONE_DATA: 'babykeepsake_widget_milestone_data'
}

// ============================================
// 内部工具函数
// ============================================

/**
 * 从本地存储读取对象数据
 * @param key 存储键名
 * @returns 解析后的对象，失败返回 null
 */
function getStorageObject<T>(key: string): T | null {
  try {
    const raw = uni.getStorageSync(key)
    if (!raw) return null
    // uni.getStorageSync 在不同平台可能返回字符串或已解析对象
    if (typeof raw === 'string') return JSON.parse(raw) as T
    return raw as T
  } catch (e) {
    console.error('[babykeepsake-widget] getStorageObject error:', e)
    return null
  }
}

/**
 * 获取当前登录用户 ID
 */
function getCurrentUserId(): string {
  try {
    const userInfo = uni.getStorageSync(STORAGE_KEYS.USER_INFO) as { userId?: string } | null
    return userInfo?.userId || 'default_user'
  } catch (e) {
    console.error('[babykeepsake-widget] getCurrentUserId error:', e)
    return 'default_user'
  }
}

/**
 * 格式化日期为 MM-DD HH:mm 格式
 */
function formatDateTime(timestamp: number): string {
  const date = new Date(timestamp)
  const month = String(date.getMonth() + 1).padStart(2, '0')
  const day = String(date.getDate()).padStart(2, '0')
  const hour = String(date.getHours()).padStart(2, '0')
  const minute = String(date.getMinutes()).padStart(2, '0')
  return `${month}-${day} ${hour}:${minute}`
}

/**
 * 格式化日期为 MM-DD 格式
 */
function formatDate(timestamp: number): string {
  const date = new Date(timestamp)
  const month = String(date.getMonth() + 1).padStart(2, '0')
  const day = String(date.getDate()).padStart(2, '0')
  return `${month}-${day}`
}

// ============================================
// 预约提醒卡片数据
// ============================================

/**
 * 获取即将到来的预约信息
 */
function getUpcomingBooking(): BookingWidgetData {
  const bookings = getStorageObject<Record<string, any>>(STORAGE_KEYS.BOOKINGS)
  if (!bookings) {
    return {
      studioName: '暂无预约',
      bookingTime: '--',
      keepsakeType: '--'
    }
  }

  const userId = getCurrentUserId()
  const now = Date.now()

  // 筛选当前用户未来的预约，按时间排序
  const upcomingBookings = Object.values(bookings)
    .filter((b: any) => b.userId === userId && b.status === 'confirmed' && b.bookingTime > now)
    .sort((a: any, b: any) => a.bookingTime - b.bookingTime)

  if (upcomingBookings.length === 0) {
    return {
      studioName: '暂无预约',
      bookingTime: '--',
      keepsakeType: '--'
    }
  }

  const next = upcomingBookings[0] as any
  return {
    studioName: next.studioName || '未命名工作室',
    bookingTime: formatDateTime(next.bookingTime),
    keepsakeType: next.keepsakeType || '未选择'
  }
}

// ============================================
// 制作进度卡片数据
// ============================================

/**
 * 获取当前制作进度
 */
function getCurrentProgress(): ProgressWidgetData {
  const orders = getStorageObject<Record<string, any>>(STORAGE_KEYS.ORDERS)
  if (!orders) {
    return {
      currentStage: '暂无订单',
      progressPercent: 0,
      estimatedCompletion: '--'
    }
  }

  const userId = getCurrentUserId()

  // 筛选进行中的订单
  const activeOrders = Object.values(orders)
    .filter((o: any) => o.userId === userId && o.status !== 'completed' && o.status !== 'cancelled')
    .sort((a: any, b: any) => (b.createdAt || 0) - (a.createdAt || 0))

  if (activeOrders.length === 0) {
    return {
      currentStage: '暂无订单',
      progressPercent: 0,
      estimatedCompletion: '--'
    }
  }

  const latest = activeOrders[0] as any
  const stageMap: Record<string, string> = {
    'collecting': '采集中',
    'producing': '制作中',
    'quality_check': '质检中',
    'shipping': '配送中',
    'completed': '已完成'
  }
  const progressMap: Record<string, number> = {
    'collecting': 20,
    'producing': 50,
    'quality_check': 75,
    'shipping': 90,
    'completed': 100
  }

  return {
    currentStage: stageMap[latest.status] || '处理中',
    progressPercent: progressMap[latest.status] || 30,
    estimatedCompletion: latest.estimatedCompletion
      ? formatDate(latest.estimatedCompletion)
      : '--'
  }
}

// ============================================
// 里程碑提醒卡片数据
// ============================================

/**
 * 获取下一个里程碑提醒
 */
function getNextMilestone(): MilestoneWidgetData {
  const milestones = getStorageObject<Record<string, any>>(STORAGE_KEYS.MILESTONES)
  const babyInfo = getStorageObject<Record<string, any>>(STORAGE_KEYS.BABY_INFO)

  // 获取宝宝月龄
  let babyAge = '--'
  if (babyInfo) {
    const userId = getCurrentUserId()
    const babies = Object.values(babyInfo).filter((b: any) => b.userId === userId)
    if (babies.length > 0) {
      const baby = babies[0] as any
      if (baby.birthDate) {
        const months = Math.floor((Date.now() - baby.birthDate) / (30 * 24 * 60 * 60 * 1000))
        babyAge = `${months}个月`
      }
    }
  }

  if (!milestones) {
    return {
      milestoneName: '暂无提醒',
      babyAge,
      nextCollectTime: '--'
    }
  }

  const userId = getCurrentUserId()
  const now = Date.now()

  // 筛选未来的里程碑
  const upcomingMilestones = Object.values(milestones)
    .filter((m: any) => m.userId === userId && !m.completed && m.collectTime > now)
    .sort((a: any, b: any) => a.collectTime - b.collectTime)

  if (upcomingMilestones.length === 0) {
    return {
      milestoneName: '暂无提醒',
      babyAge,
      nextCollectTime: '--'
    }
  }

  const next = upcomingMilestones[0] as any
  return {
    milestoneName: next.name || '成长记录',
    babyAge,
    nextCollectTime: formatDate(next.collectTime)
  }
}

// ============================================
// 对外接口
// ============================================

/**
 * 获取预约提醒卡片展示数据
 */
export function getBookingWidgetData(): BookingWidgetData {
  const data = getUpcomingBooking()

  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_BOOKING_DATA, data)
  } catch (e) {
    console.error('[babykeepsake-widget] cache booking data error:', e)
  }

  console.log('[babykeepsake-widget] getBookingWidgetData:', JSON.stringify(data))
  return data
}

/**
 * 获取制作进度卡片展示数据
 */
export function getProgressWidgetData(): ProgressWidgetData {
  const data = getCurrentProgress()

  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_PROGRESS_DATA, data)
  } catch (e) {
    console.error('[babykeepsake-widget] cache progress data error:', e)
  }

  console.log('[babykeepsake-widget] getProgressWidgetData:', JSON.stringify(data))
  return data
}

/**
 * 获取里程碑提醒卡片展示数据
 */
export function getMilestoneWidgetData(): MilestoneWidgetData {
  const data = getNextMilestone()

  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_MILESTONE_DATA, data)
  } catch (e) {
    console.error('[babykeepsake-widget] cache milestone data error:', e)
  }

  console.log('[babykeepsake-widget] getMilestoneWidgetData:', JSON.stringify(data))
  return data
}

/**
 * 更新预约提醒服务卡片
 */
export function updateBookingWidget(data: BookingWidgetData): void {
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_BOOKING_DATA, data)
  } catch (e) {
    console.error('[babykeepsake-widget] cache booking data error:', e)
  }

  console.log('[babykeepsake-widget] updateBookingWidget:', JSON.stringify(data))

  try {
    uni.$emit('babykeepsake_booking_widget_data_changed', data)
  } catch (e) {
    console.error('[babykeepsake-widget] emit booking widget update error:', e)
  }
}

/**
 * 更新制作进度服务卡片
 */
export function updateProgressWidget(data: ProgressWidgetData): void {
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_PROGRESS_DATA, data)
  } catch (e) {
    console.error('[babykeepsake-widget] cache progress data error:', e)
  }

  console.log('[babykeepsake-widget] updateProgressWidget:', JSON.stringify(data))

  try {
    uni.$emit('babykeepsake_progress_widget_data_changed', data)
  } catch (e) {
    console.error('[babykeepsake-widget] emit progress widget update error:', e)
  }
}

/**
 * 更新里程碑提醒服务卡片
 */
export function updateMilestoneWidget(data: MilestoneWidgetData): void {
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_MILESTONE_DATA, data)
  } catch (e) {
    console.error('[babykeepsake-widget] cache milestone data error:', e)
  }

  console.log('[babykeepsake-widget] updateMilestoneWidget:', JSON.stringify(data))

  try {
    uni.$emit('babykeepsake_milestone_widget_data_changed', data)
  } catch (e) {
    console.error('[babykeepsake-widget] emit milestone widget update error:', e)
  }
}

/**
 * 卡片点击处理 — 跳转到预约页面
 */
export function onBookingWidgetClick(): void {
  console.log('[babykeepsake-widget] booking widget clicked')
  try {
    uni.setStorageSync('babykeepsake_widget_click_time', Date.now())
    uni.setStorageSync('babykeepsake_widget_click_target', 'booking')
  } catch (e) {
    console.error('[babykeepsake-widget] record click error:', e)
  }
}

/**
 * 卡片点击处理 — 跳转到进度页面
 */
export function onProgressWidgetClick(): void {
  console.log('[babykeepsake-widget] progress widget clicked')
  try {
    uni.setStorageSync('babykeepsake_widget_click_time', Date.now())
    uni.setStorageSync('babykeepsake_widget_click_target', 'progress')
  } catch (e) {
    console.error('[babykeepsake-widget] record click error:', e)
  }
}

/**
 * 卡片点击处理 — 跳转到里程碑页面
 */
export function onMilestoneWidgetClick(): void {
  console.log('[babykeepsake-widget] milestone widget clicked')
  try {
    uni.setStorageSync('babykeepsake_widget_click_time', Date.now())
    uni.setStorageSync('babykeepsake_widget_click_target', 'milestone')
  } catch (e) {
    console.error('[babykeepsake-widget] record click error:', e)
  }
}

/**
 * 卡片生命周期：首次创建
 */
export function onWidgetCreate(): void {
  console.log('[babykeepsake-widget] widget created')
  getBookingWidgetData()
  getProgressWidgetData()
  getMilestoneWidgetData()
}

/**
 * 卡片生命周期：销毁
 */
export function onWidgetDestroy(): void {
  console.log('[babykeepsake-widget] widget destroyed')
  try {
    uni.removeStorageSync(STORAGE_KEYS.WIDGET_BOOKING_DATA)
    uni.removeStorageSync(STORAGE_KEYS.WIDGET_PROGRESS_DATA)
    uni.removeStorageSync(STORAGE_KEYS.WIDGET_MILESTONE_DATA)
  } catch (e) {
    console.error('[babykeepsake-widget] cleanup error:', e)
  }
}
