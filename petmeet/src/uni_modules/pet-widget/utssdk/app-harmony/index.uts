/**
 * PetMeet 鸿蒙负一屏服务卡片 UTS 插件
 *
 * 本插件仅在鸿蒙端（APP-HARMONY）编译运行，提供服务卡片的数据获取、更新和点击跳转能力。
 * 由于 UTS 在鸿蒙端编译为 ArkTS，可直接调用鸿蒙原生 API。
 *
 * 注意：服务卡片实际运行需要在鸿蒙真机或模拟器环境中测试，
 * 此处为完整的接口结构和模拟实现。
 */

// ============================================
// 类型定义
// ============================================

/**
 * 服务卡片展示数据接口
 */
export interface WidgetData {
  /** 宠物名字 */
  petName: string
  /** 宠物头像路径 */
  petAvatar: string
  /** 最近日记摘要 */
  latestDiary: string
  /** 宠友数量 */
  friendCount: number
}

// ============================================
// 本地存储键名（与 App 端保持一致）
// ============================================

const STORAGE_KEYS = {
  PETS: 'petmeet_db_pets',
  DIARIES: 'petmeet_db_diaries',
  FRIENDSHIPS: 'petmeet_db_friendships',
  USER_INFO: 'userInfo',
  WIDGET_DATA: 'petmeet_widget_data'
}

// ============================================
// 内部工具函数
// ============================================

/**
 * 从本地存储读取对象数据
 * @param key 存储键名
 * @returns 解析后的对象，失败返回 null
 */
function getStorageObject<T>(key: string): T | null {
  try {
    const raw = uni.getStorageSync(key)
    if (!raw) return null
    // uni.getStorageSync 在不同平台可能返回字符串或已解析对象
    if (typeof raw === 'string') return JSON.parse(raw) as T
    return raw as T
  } catch (e) {
    console.error('[pet-widget] getStorageObject error:', e)
    return null
  }
}

/**
 * 获取当前登录用户 ID
 */
function getCurrentUserId(): string {
  try {
    const userInfo = uni.getStorageSync(STORAGE_KEYS.USER_INFO) as { userId?: string } | null
    return userInfo?.userId || 'default_user'
  } catch (e) {
    console.error('[pet-widget] getCurrentUserId error:', e)
    return 'default_user'
  }
}

/**
 * 从 pets 存储中获取当前用户的主宠物
 */
function getPrimaryPet(): { name: string; avatar: string } | null {
  const pets = getStorageObject<Record<string, any>>(STORAGE_KEYS.PETS)
  if (!pets) return null

  const userId = getCurrentUserId()
  const userPets = Object.values(pets).filter((p: any) => p.userId === userId)
  if (userPets.length === 0) return null

  // 取第一个宠物作为主宠物
  const primary = userPets[0]
  return {
    name: primary.name || '未命名宠物',
    avatar: primary.avatar || ''
  }
}

/**
 * 获取最近一篇日记的内容摘要
 */
function getLatestDiarySummary(): string {
  const diaries = getStorageObject<Record<string, any>>(STORAGE_KEYS.DIARIES)
  if (!diaries) return '还没有日记哦~'

  const userId = getCurrentUserId()
  const userDiaries = Object.values(diaries)
    .filter((d: any) => d.userId === userId)
    .sort((a: any, b: any) => (b.createdAt || 0) - (a.createdAt || 0))

  if (userDiaries.length === 0) return '还没有日记哦~'

  const latest = userDiaries[0] as any
  const content = latest.content || ''
  // 截取前 30 字符作为摘要
  return content.length > 30 ? content.substring(0, 30) + '...' : content
}

/**
 * 获取宠友数量
 */
function getFriendCount(): number {
  const friendships = getStorageObject<Record<string, any>>(STORAGE_KEYS.FRIENDSHIPS)
  if (!friendships) return 0

  const userId = getCurrentUserId()
  const activeFriends = Object.values(friendships).filter(
    (f: any) => f.userId === userId && f.status === 'active'
  )
  return activeFriends.length
}

// ============================================
// 对外接口
// ============================================

/**
 * 获取卡片展示数据
 *
 * 从 App 本地存储中读取宠物信息、最近日记和宠友数量，
 * 组装为 WidgetData 返回给服务卡片使用。
 *
 * @returns WidgetData 卡片展示数据
 */
export function getWidgetData(): WidgetData {
  const pet = getPrimaryPet()
  const data: WidgetData = {
    petName: pet?.name || '我的宠物',
    petAvatar: pet?.avatar || '',
    latestDiary: getLatestDiarySummary(),
    friendCount: getFriendCount()
  }

  // 将当前卡片数据缓存到本地，供卡片刷新时使用
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_DATA, data)
  } catch (e) {
    console.error('[pet-widget] cache widget data error:', e)
  }

  console.log('[pet-widget] getWidgetData:', JSON.stringify(data))
  return data
}

/**
 * 更新服务卡片内容
 *
 * 将最新的 WidgetData 同步到鸿蒙服务卡片。
 * 实际实现中需要调用鸿蒙 FormManager 的 updateForm 接口。
 *
 * @param data 最新的卡片展示数据
 */
export function updateWidget(data: WidgetData): void {
  // 1. 先缓存到本地存储
  try {
    uni.setStorageSync(STORAGE_KEYS.WIDGET_DATA, data)
  } catch (e) {
    console.error('[pet-widget] cache widget data error:', e)
  }

  // 2. 调用鸿蒙原生接口更新服务卡片（模拟实现）
  // 实际真机环境中，需要通过 FormManager 获取当前 formId 并触发更新
  // 示例：
  // import formManager from '@ohos.app.form.formManager';
  // formManager.updateForm(formId, formBindingData.createFormBindingData(data));

  console.log('[pet-widget] updateWidget:', JSON.stringify(data))

  // 触发自定义事件通知卡片刷新（UTS 层向 ArkUI 卡片通信）
  try {
    uni.$emit('pet_widget_data_changed', data)
  } catch (e) {
    console.error('[pet-widget] emit widget update error:', e)
  }
}

/**
 * 卡片点击处理
 *
 * 用户点击服务卡片时，唤起 PetMeet App 并跳转到首页。
 * 实际实现中需要调用鸿蒙 Want 机制进行应用跳转。
 */
export function onWidgetClick(): void {
  console.log('[pet-widget] widget clicked, launching app...')

  // 鸿蒙端通过 Want 机制启动应用
  // 模拟实现：记录点击时间，App 启动时读取并跳转对应页面
  try {
    uni.setStorageSync('petmeet_widget_click_time', Date.now())
  } catch (e) {
    console.error('[pet-widget] record click time error:', e)
  }

  // 实际真机环境中，应使用如下方式启动应用：
  // import Want from '@ohos.app.ability.Want';
  // const want: Want = {
  //   bundleName: 'com.petmeet.app',
  //   abilityName: 'EntryAbility',
  //   parameters: {
  //     fromWidget: true,
  //     targetPage: '/pages/index/index'
  //   }
  // };
  // context.startAbility(want);
}

/**
 * 卡片生命周期：首次创建
 *
 * 服务卡片被添加到桌面/负一屏时调用，初始化卡片数据。
 */
export function onWidgetCreate(): void {
  console.log('[pet-widget] widget created')
  getWidgetData()
}

/**
 * 卡片生命周期：销毁
 *
 * 服务卡片被移除时调用，执行清理操作。
 */
export function onWidgetDestroy(): void {
  console.log('[pet-widget] widget destroyed')
  try {
    uni.removeStorageSync(STORAGE_KEYS.WIDGET_DATA)
  } catch (e) {
    console.error('[pet-widget] cleanup error:', e)
  }
}
