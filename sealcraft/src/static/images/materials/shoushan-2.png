<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <rect width="400" height="400" fill="#F5F5F5"/>
  
    <!-- 材质纹理背景 -->
    <defs>
      <linearGradient id="grad_shoushan_1" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#C4A87A;stop-opacity:0.3"/>
        <stop offset="100%" style="stop-color:#E8D5B7;stop-opacity:0.5"/>
      </linearGradient>
    </defs>
    <rect x="40" y="40" width="320" height="240" rx="16" fill="url(#grad_shoushan_1)"/>
    <rect x="40" y="40" width="320" height="240" rx="16" fill="none" stroke="#C4A87A" stroke-width="2" opacity="0.6"/>
    <!-- 材质标识 -->
    <rect x="150" y="140" width="100" height="80" rx="8" fill="#C4A87A" opacity="0.85"/>
    <text x="200" y="192" text-anchor="middle" font-size="36" font-weight="bold" fill="#FFFFFF" font-family="serif">寿山石</text>
    <!-- 底部文字 -->
    <text x="200" y="340" text-anchor="middle" font-size="22" fill="#2C2C2C" font-family="sans-serif">寿山石材质 · 示例2</text>
    <text x="200" y="370" text-anchor="middle" font-size="14" fill="#999" font-family="sans-serif">SealCraft</text>
</svg>