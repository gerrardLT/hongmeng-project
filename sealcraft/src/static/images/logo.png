<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <rect width="400" height="400" fill="transparent"/>
  
    <!-- 外圆 -->
    <circle cx="200" cy="200" r="160" fill="#C41A1A"/>
    <circle cx="200" cy="200" r="148" fill="none" stroke="#FFFFFF" stroke-width="3" opacity="0.4"/>
    <circle cx="200" cy="200" r="140" fill="none" stroke="#FFFFFF" stroke-width="1" opacity="0.3"/>
    <!-- "印" 字 -->
    <text x="200" y="225" text-anchor="middle" font-size="140" font-weight="bold" fill="#FFFFFF" font-family="serif">印</text>
    <!-- 底部弧形文字 -->
    <text x="200" y="380" text-anchor="middle" font-size="18" fill="#C41A1A" font-family="sans-serif">SealCraft</text>
</svg>